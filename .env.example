# ── Core ────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.asms.app

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/asms_db

# ── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Email ────────────────────────────────────────────
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-password
DEFAULT_FROM_EMAIL=ASMS <noreply@asms.app>

# ── SMS — Africa's Talking ───────────────────────────
AFRICASTALKING_API_KEY=your-key
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=ASMS

# ── Payments ─────────────────────────────────────────
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxx
FLUTTERWAVE_WEBHOOK_SECRET=your-webhook-secret

# ── Storage ──────────────────────────────────────────
CLOUDINARY_URL=cloudinary://key:secret@cloud_name

# ── Platform ─────────────────────────────────────────
PLATFORM_ADMIN_EMAIL=admin@asms.app
PLATFORM_DOMAIN=asms.app
